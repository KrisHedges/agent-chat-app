{
  "name": "agent-chat-app-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend Agent Service using Google GenAI SDK",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "NODE_ENV=test tsx --test test/**/*.test.ts",
    "test:debug": "DEBUG=1 NODE_ENV=test tsx --test test/**/*.test.ts",
    "test:coverage": "NODE_ENV=test tsx --test --experimental-test-coverage test/**/*.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
